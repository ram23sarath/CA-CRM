# Supabase connection settings. Replace placeholders only in a local environment file.
SUPABASE_URL=<supabase-project-url>
SUPABASE_ANON_KEY=<supabase-anon-key>

# Canonical public origin used for same-origin request validation in production.
APP_ORIGIN=http://localhost:3000

# Server-only worker/migration setting. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optional server-side cap for each private client document. Must not exceed the
# firm-documents bucket limit configured by the Stage 4 migration.
CLIENT_DOCUMENT_MAX_BYTES=52428800

# Stage 9 worker safety defaults. External channels remain preview-only.
AUTOMATION_MODE=preview
AUTOMATION_WORKER_ENABLED=false
